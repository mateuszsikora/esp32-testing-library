# Only configuration differs from esp-protocols modem-v1.4.1's example.
CONFIG_EXAMPLE_MODEM_DEVICE_SIM7600=y
CONFIG_EXAMPLE_MODEM_UART_TX_PIN=26
CONFIG_EXAMPLE_MODEM_UART_RX_PIN=27
CONFIG_EXAMPLE_MODEM_UART_RTS_PIN=25
CONFIG_EXAMPLE_MODEM_UART_CTS_PIN=23
CONFIG_EXAMPLE_FLOW_CONTROL_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
