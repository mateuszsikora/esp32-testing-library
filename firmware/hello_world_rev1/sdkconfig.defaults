# hello_world, ESP-IDF's example unchanged, built for ESP32-P4 chip revisions below v3.0 (v0.x and
# v1.x): ESP-IDF v5.5.x builds for v3.0 and later unless told otherwise
# (components/esp_hw_support/port/esp32p4/Kconfig.hw_support), and the two families do not run
# each other's images. Built for the ESP32-P4 only (firmware/build.sh names it); the runner runs it
# on esp32sim's rev < 3 model, and the backend gives it the ROM of that revision.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
