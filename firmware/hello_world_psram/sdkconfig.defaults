# hello_world, ESP-IDF's example unchanged, with its PSRAM on: on top of the example's own
# configuration (firmware/build.sh names it). Built for the ESP32-S3 only, whose devkit profile,
# esp32-s3-devkitc, is an N8R8 module: 8 MiB of octal PSRAM. ESP-IDF's PSRAM driver then finds it
# at start-up, tests it and adds it to the heap.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
