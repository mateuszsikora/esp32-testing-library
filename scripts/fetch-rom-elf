#!/bin/sh
# Puts the ESP32 mask ROM ELF the tests run on at
# .cache/esp-rom-elfs/$RELEASE/$ROM (plan M0). Release 20241011 is pinned by
# the checksum of the ELF itself: newer releases ship the same
# esp32_rev300_rom.elf, so a copy from any release under ~/.espressif counts,
# and one that differs is passed over. Without one, the release tarball is
# downloaded from GitHub and checked against its own pinned checksum.
#
# Written for `make setup`; prints nothing when the ELF is already in place.
set -eu

RELEASE=20241011
ROM=esp32_rev300_rom.elf
ROM_SHA256=920b70635440517866aab2230964a570d2cf2b676658d93c52fbac108c1cca31
TARBALL=esp-rom-elfs-$RELEASE.tar.gz
TARBALL_SHA256=921f000164a421c7628fbfee55b173384aafaa51883adc65cd27bf9b0af9e9a9
URL=https://github.com/espressif/esp-rom-elfs/releases/download/$RELEASE/$TARBALL

dest_dir=.cache/esp-rom-elfs/$RELEASE
dest=$dest_dir/$ROM

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

if [ -f "$dest" ] && [ "$(sha256 "$dest")" = "$ROM_SHA256" ]; then
	exit 0
fi

mkdir -p "$dest_dir"
tmp=$(mktemp -d "$dest_dir/.fetch.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# The pinned release first, so that the message names it when it is there.
# IDF_TOOLS_PATH is where ESP-IDF's installer puts its tools when set.
tools=${IDF_TOOLS_PATH:-${HOME:-}/.espressif}/tools/esp-rom-elfs
for f in "$tools/$RELEASE/$ROM" "$tools"/*/"$ROM"; do
	if [ -f "$f" ] && [ "$(sha256 "$f")" = "$ROM_SHA256" ]; then
		# A copy, not a link: an ESP-IDF upgrade may remove the release it came from.
		cp "$f" "$tmp/$ROM"
		mv "$tmp/$ROM" "$dest"
		echo "fetch-rom-elf: $dest copied from $f"
		exit 0
	fi
done

echo "fetch-rom-elf: no $ROM of release $RELEASE under $tools; downloading $URL"
curl -fsSL --retry 3 -o "$tmp/$TARBALL" "$URL"
got=$(sha256 "$tmp/$TARBALL")
if [ "$got" != "$TARBALL_SHA256" ]; then
	echo "fetch-rom-elf: $TARBALL has SHA-256 $got, expected $TARBALL_SHA256" >&2
	exit 1
fi
tar -xzf "$tmp/$TARBALL" -C "$tmp" "$ROM"
got=$(sha256 "$tmp/$ROM")
if [ "$got" != "$ROM_SHA256" ]; then
	echo "fetch-rom-elf: $ROM in $TARBALL has SHA-256 $got, expected $ROM_SHA256" >&2
	exit 1
fi
mv "$tmp/$ROM" "$dest"
echo "fetch-rom-elf: $dest downloaded"
